PORT=3000
ADMIN_PASSWORD=change-me
PARTY_TITLE=The Party
PARTY_ADDRESS=123 Example St, Somewhere
PARTY_DESCRIPTION=Replace this with the real party description.

# When true, guests pick an arrival/departure time range and per-slot density is
# shown. Default false = a plain name + phone RSVP, no times requested or shown.
COLLECT_TIMES=false

# SMS reminders (Twilio). Leave the Twilio vars empty to disable reminders.
EVENT_DATE=2026-06-19
# Hour (0-23) and timezone the reminder waves are sent in. Defaults to 10am
# Pacific. The timezone is honored regardless of the container's TZ.
REMINDER_SEND_HOUR=10
REMINDER_TZ=America/Los_Angeles
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: either a purchased number (E.164) or a Messaging Service SID.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
